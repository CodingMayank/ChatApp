{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/onboarding",
      "destination": "/index.html"
    },
    {
      "source": "/groups",
      "destination": "/index.html"
    },
    {
      "source": "/create-group",
      "destination": "/index.html"
    },
    {
      "source": "/chat/:groupId",
      "destination": "/index.html"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    },
    {
      "source": "/location-permission",
      "destination": "/index.html"
    }
  ]
}
